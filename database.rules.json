{
  "rules": {
    "rooms": {
      "main": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'j8jkVUOib3OzitCfMfbIuEhYXfC2'",
        "players": {
          "$playerId": {
            "name": {
              ".write": "auth != null && auth.uid === $playerId && !data.exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 25"
            },
            "answers": {
              "$round": {
                ".write": "auth != null && auth.uid === $playerId && $round == (root.child('rooms/main/game/round').val() + '') && root.child('rooms/main/game/phase').val() === 'question'",
                ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
              }
            },
            "teams": {
              "$round": {
                "before": {
                  ".write": "auth != null && auth.uid === $playerId && $round == (root.child('rooms/main/game/round').val() + '') && root.child('rooms/main/game/phase').val() === 'team'",
                  ".validate": "newData.isString() && (newData.val() === 'boy' || newData.val() === 'girl')"
                },
                "after": {
                  ".write": "auth != null && auth.uid === $playerId && $round == (root.child('rooms/main/game/round').val() + '') && root.child('rooms/main/game/phase').val() === 'switch'",
                  ".validate": "newData.isString() && (newData.val() === 'boy' || newData.val() === 'girl')"
                }
              }
            }
          }
        }
      }
    }
  }
}
